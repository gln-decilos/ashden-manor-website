---
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/global.css';
import Photo from '../components/Photo.astro';

const title = 'Ashden Manor · An exclusive-use Georgian wedding venue';
const description =
  'A Georgian manor in the English countryside, hosting one wedding at a time for up to 100 guests. Ceremony, dinner and evening party, with the whole house to yourselves.';

const exclusive = [
  {
    title: 'The gates are yours',
    body: 'Your guests come up the drive to your wedding, not past a reception desk and somebody else’s conference.',
  },
  {
    title: 'Every room is set for you',
    body: 'The ceremony room, the Georgian dining room, the gardens and a private dressing room. Nothing shared, nothing roped off for another party.',
  },
  {
    title: 'One wedding, one team',
    body: 'We host one wedding at a time, so the people looking after you aren’t also running a function down the corridor.',
  },
  {
    title: 'The whole day, in one place',
    body: 'Ceremony, dinner and the evening party all happen here. No coaches between venues, no guests left wondering where to go next.',
  },
  {
    title: 'Bring the dog',
    body: 'Ashden is pet-friendly. If your dog is family, they’re on the guest list too.',
  },
];

const day = [
  {
    time: 'Morning',
    room: 'The dressing room',
    body: 'Get ready in a private dressing room with space for everyone who should be in it, and a door you can close.',
    photo: 'dressing',
    alt: 'A bride in a silk playsuit stands on a chair singing into a hairbrush while her bridesmaids, in matching robes, cheer her on',
  },
  {
    time: 'Afternoon',
    room: 'The ceremony room',
    body: 'Say your vows indoors, in a room that works whatever the English weather decides to do.',
    photo: 'panelled',
    alt: 'A bride and groom stand apart in a wood-panelled room, light falling across the floorboards from a tall window',
  },
  {
    time: 'Drinks',
    room: 'The gardens',
    body: 'Out onto the lawns for drinks and photographs, with nobody in shot who wasn’t invited.',
    photo: 'fountain',
    alt: 'A tiered stone fountain filled with ice and bottles of champagne in a garden',
  },
  {
    time: 'Dinner',
    room: 'The dining room',
    body: 'Everyone sits down together for dinner, cooked in our own kitchen and served by the same team.',
    photo: 'toast',
    alt: 'Guests raise coupes of champagne over a candlelit dinner table set with crystal and white flowers',
  },
  {
    time: 'Evening',
    room: 'The party',
    body: 'Then the music starts. Nobody else is booked in after you, so the evening belongs to your wedding.',
    photo: 'dancing',
    alt: 'A bride dances with friends under warm, blurred party lights',
  },
] as const;

const compare = [
  {
    label: 'Who else is there',
    hotel: 'Residents, diners and whoever else is booked in that day',
    ashden: 'Your guests and our team. That’s everyone.',
  },
  {
    label: 'The spaces',
    hotel: 'A function suite, while the rest of the building carries on as normal',
    ashden: 'The whole manor: ceremony room, dining room, gardens and dressing room',
  },
  {
    label: 'The food',
    hotel: 'A banqueting kitchen that also feeds the restaurant and room service',
    ashden: 'Our own kitchen, cooking for one wedding',
  },
  {
    label: 'Your photographs',
    hotel: 'Corridors, lifts and strangers in the background',
    ashden: 'Georgian rooms and gardens, and only your people in them',
  },
  {
    label: 'The dog',
    hotel: 'Usually a polite no',
    ashden: 'Welcome',
  },
];

const ribbon = [
  'Exclusive use',
  'One wedding at a time',
  'Up to 100 guests',
  'In-house kitchen',
  'The whole manor',
  'Est. 18—',
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3B4034" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/img/og-ashden-manor.jpg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
<link rel="preload" as="image" href="/img/hero-bg-2.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- Scroll progress hairline -->
    <div class="progress" aria-hidden="true"><span class="progress__bar"></span></div>

    <header class="site-header" id="top">
      <div class="container site-header__inner">
        <a class="brand" href="#top" aria-label="Ashden Manor, back to top">
          <img src="/img/logo-crest-ink.webp" alt="" width="160" height="148" />
          <span class="brand__wordmark">Ashden Manor<small>EST. 18—</small></span>
        </a>
        <button class="nav-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false">
          <span></span><span></span>
        </button>
        <nav class="site-nav" id="site-navigation" aria-label="Sections">
          <a href="#exclusive-use"><span>The manor</span></a>
          <a href="#food"><span>Food</span></a>
          <a href="#the-day"><span>Your day</span></a>
          <a href="#enquire"><span>Questions</span></a>
          <a class="btn btn--dark btn--small header-visit magnetic" href="#enquire">
            <span>Arrange a visit</span>
            <span aria-hidden="true"></span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- 1. Hero -->
      <section class="hero" aria-labelledby="hero-title">
        <figure class="hero__media">
          <div class="hero__parallax" data-parallax>
<img
  src="/img/hero-bg.png"
  alt="Ashden Manor seen from above: a stone Georgian house with wisteria on its walls, wedding guests gathered across the lawns and terraces, and fields rolling away behind"
  width="735"
  height="1103"
  loading="eager"
  fetchpriority="high"
  decoding="async"
/>
          </div>
          
        </figure>

        <div class="container hero__grid">
          <p class="eyebrow hero__eyebrow" data-split>A Georgian manor in the English countryside</p>
          <h1 class="hero__title" id="hero-title">
            For one day, <em>the whole house</em> is yours.
          </h1>
          <p class="hero__lede">
            Ashden hosts one wedding at a time. From the ceremony to the last dance,
            the manor, the gardens and the dining room belong to you and up to a
            hundred of your people.
          </p>
          <div class="hero__actions">
            <a class="btn btn--light magnetic" href="#enquire">
              <span>Arrange a visit</span>
              <span aria-hidden="true"></span>
            </a>
            <a class="link-arrow hero__link" href="#exclusive-use">What exclusive use means</a>
          </div>
          
        </div>

        <span class="hero__scroll" aria-hidden="true">
          <span class="hero__scroll-dot"></span>
        </span>
      </section>

      <!-- Ribbon marquee -->
      <div class="ribbon" aria-hidden="true">
        <div class="ribbon__track">
          {[...ribbon, ...ribbon].map((w) => (
            <span class="ribbon__item">{w}<span class="ribbon__dot"></span></span>
          ))}
        </div>
      </div>

      <!-- 2. Exclusive use -->
      <section class="section exclusive" id="exclusive-use" aria-labelledby="exclusive-title">
        <div class="container exclusive__grid">
          <figure class="exclusive__media" data-reveal="left">
            <div class="panel panel--hover">
              <Photo
                name="drive"
                sizes="(min-width: 900px) 30rem, 90vw"
                alt="A green vintage sports car drives through open stone gateposts dressed with flowers, down a tree-lined gravel drive into the countryside"
              />
            </div>
            <figcaption class="media-caption">
              <span aria-hidden="true">◈</span> The drive, dressed for the day
            </figcaption>
          </figure>
          <div class="exclusive__body">
            <p class="eyebrow" data-reveal>What exclusive use actually means</p>
            <h2 id="exclusive-title" data-reveal>Nobody else is checking in.</h2>
            <span class="ornament" data-reveal aria-hidden="true"></span>
            <p class="intro" data-reveal>
              Plenty of venues say “exclusive use”. Here it means something simple:
              from the morning you arrive to the end of the party, the only people in
              the house are your guests and the team looking after them.
            </p>
            <ol class="numbered">
              {
                exclusive.map((item, i) => (
                  <li data-reveal style={`--i:${i}`}>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <!-- 3. Hundred -->
      <section class="section hundred" aria-labelledby="hundred-title">
        <div class="container hundred__grid">
          <div class="hundred__head">
            <p class="hundred__number" aria-hidden="true" data-count="100">0</p>
            <p class="eyebrow" data-reveal>Is a hundred enough?</p>
            <h2 id="hundred-title" data-reveal>It’s the number that makes the day.</h2>
            <p class="intro" data-reveal>
              Couples often ask whether a hundred guests is too few. Once they’ve
              walked round, most of them tell us it’s exactly right, and the reasons
              are mostly about how the day feels.
            </p>
          </div>
          <figure class="hundred__media" data-reveal="right">
            <div class="arch arch--soft arch--hover">
              <Photo
                name="feast"
                sizes="(min-width: 900px) 26rem, 90vw"
                alt="Guests lean in across a long candlelit table crowded with sharing plates, passing food to one another"
              />
            </div>
          </figure>
          <ul class="hundred__points">
            <li data-reveal style="--i:0">
              <h3>You get to talk to everyone</h3>
              <p>
                At two hundred, couples spend the reception doing laps. At a hundred
                there’s time for a proper conversation with your grandmother and your
                oldest friend.
              </p>
            </li>
            <li data-reveal style="--i:1">
              <h3>Nobody is on the edge of things</h3>
              <p>
                Everyone hears the speeches and sees the first dance. No overflow
                tables, no back of the room.
              </p>
            </li>
            <li data-reveal style="--i:2">
              <h3>The house sets the limit, so you don’t have to</h3>
              <p>
                It’s easier to write a guest list around the people you’d miss than
                the ones you feel you ought to ask.
              </p>
            </li>
          </ul>
        </div>
      </section>

      <!-- 4. The day -->
      <section class="section day" id="the-day" aria-labelledby="day-title">
        <div class="container">
          <div class="day__head">
            <p class="eyebrow" data-reveal>A full day at Ashden</p>
            <h2 id="day-title" data-reveal>Ceremony to last dance, under one roof.</h2>
            <p class="intro" data-reveal>
              Every part of the day has its own room, and none of them are shared.
              Here’s how it usually runs.
            </p>
          </div>
        </div>
        <div class="day__track" tabindex="0" role="region" aria-label="The wedding day, from morning to evening. Scroll sideways for more." data-track>
          <ol class="day__list">
            {
              day.map((stop, i) => (
                <li class="day__stop" data-reveal style={`--i:${i}`}>
                  <p class="day__time">{stop.time}</p>
                  <div class="panel panel--small panel--hover">
                    <Photo name={stop.photo} alt={stop.alt} sizes="(min-width: 1100px) 15rem, (min-width: 700px) 40vw, 74vw" />
                  </div>
                  <h3>{stop.room}</h3>
                  <p>{stop.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
        <p class="day__hint container" aria-hidden="true">Swipe through the day</p>
      </section>

      <!-- 5. Food -->
      <section class="section food" id="food" aria-labelledby="food-title">
        <div class="container food__grid">
          <div class="food__media" data-reveal="left">
            <div class="food__main panel panel--hover">
              <Photo
                name="canapes"
                sizes="(min-width: 900px) 28rem, 78vw"
                alt="Rows of toasted crostini topped with soft cheese, roasted cherry tomatoes and herbs on a wooden board"
              />
            </div>
            <div class="food__inset" data-parallax="0.15">
              <Photo
                name="salmon"
                sizes="(min-width: 900px) 14rem, 44vw"
                alt="Canapé spoons of cured salmon and small savoury tarts arranged on dark slate"
              />
            </div>
          </div>
          <div class="food__body">
            <p class="eyebrow" data-reveal>In-house catering</p>
            <h2 id="food-title" data-reveal>The food is cooked here, by us.</h2>
            <span class="ornament" data-reveal aria-hidden="true"></span>
            <p class="intro" data-reveal>
              Food is a big part of what we do, so we don’t hand it to an outside
              caterer. Our own kitchen cooks your wedding, from the first canapé on
              the lawn to dinner in the Georgian dining room.
            </p>
            <p data-reveal>
              That matters more than it sounds. The people who plan your menu are the
              people who cook and serve it, so nothing gets lost between the planning
              and the day. A guest’s allergy is something the kitchen already knows
              about, not a note passed down the line.
            </p>
          </div>
        </div>
      </section>

      <!-- 6. Feel -->
      <section class="section feel" aria-labelledby="feel-title">
        <div class="container feel__grid">
          <div class="feel__body">
            <p class="eyebrow" data-reveal>How it feels</p>
            <h2 id="feel-title" data-reveal>Elegant. Never stuffy.</h2>
            <span class="ornament ornament--light" data-reveal aria-hidden="true"></span>
            <p class="intro" data-reveal>
              Georgian rooms can look formal in photographs. On the day, Ashden feels
              like a house, because that’s what it is.
            </p>
            <p data-reveal>
              Picture a dressing room full of your friends, a garden for the children
              to run round, and a dog asleep somewhere near the top table. We look
              after the details so that nobody has to stand on ceremony (except,
              briefly, at the ceremony).
            </p>
          </div>
          <div class="feel__media">
            <figure class="feel__a arch" data-reveal="left">
              <Photo
                name="tower"
                sizes="(min-width: 900px) 20rem, 56vw"
                alt="A laughing bride pours champagne into a coupe tower in a sunny garden while the groom cheers"
              />
            </figure>
            <figure class="feel__b" data-reveal="right" data-parallax="0.08">
              <Photo
                name="sparklers"
                sizes="(min-width: 900px) 18rem, 50vw"
                alt="A couple kiss beneath an arch of sparklers held by their guests at night"
              />
            </figure>
          </div>
        </div>
      </section>

      <!-- 7. Compare -->
      <section class="section compare" id="why-a-house" aria-labelledby="compare-title">
        <div class="container">
          <div class="compare__head">
            <p class="eyebrow" data-reveal>A house, not a hotel</p>
            <h2 id="compare-title" data-reveal>Why not a nice hotel?</h2>
            <p class="intro" data-reveal>
              It’s a fair question, and plenty of hotels do weddings well. The
              difference is that a hotel is open to everyone, and your wedding is one
              of the things going on there that day. At Ashden, it’s the only thing.
            </p>
          </div>
          <table class="compare__table" data-reveal>
            <caption class="visually-hidden">How a wedding at Ashden Manor compares with a hotel wedding</caption>
            <thead>
              <tr>
                <td></td>
                <th scope="col">A hotel wedding</th>
                <th scope="col" class="is-ashden">Ashden Manor</th>
              </tr>
            </thead>
            <tbody>
              {
                compare.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td data-label="At a hotel">{row.hotel}</td>
                    <td data-label="At Ashden" class="is-ashden">{row.ashden}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- 8. Enquiry -->
      <section class="section enquire" id="enquire" aria-labelledby="enquire-title">
        <div class="container enquire__grid">
          <div class="enquire__intro">
            <p class="eyebrow" data-reveal>Enquiries and visits</p>
            <h2 id="enquire-title" data-reveal>Come and see it for yourselves.</h2>
            <span class="ornament" data-reveal aria-hidden="true"></span>
            <p class="intro" data-reveal>
              The best way to know whether Ashden is right for you is to walk round
              it. Tell us a little about your plans and we’ll be in touch to arrange
              a visit.
            </p>
            <figure class="enquire__media arch" data-reveal>
              <Photo
                name="avenue"
                sizes="(min-width: 900px) 24rem, 80vw"
                alt="A bride and groom walk hand in hand down an avenue of trees towards the low evening sun, her dress catching the light"
              />
            </figure>
          </div>

          <div class="enquire__card">
            <form
              class="form"
              name="enquiry"
              method="POST"
              action="/"
              data-netlify="true"
              netlify-honeypot="bot-field"
              novalidate
            >
              <input type="hidden" name="form-name" value="enquiry" />
              <input type="hidden" name="subject" value="New wedding enquiry from the Ashden Manor website" />
              <p class="visually-hidden">
                <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
              </p>

              <fieldset class="form__group">
                <legend class="form__legend">About you</legend>
                <div class="form__row">
                  <div class="field">
                    <label for="f-name">Your name <span class="req" aria-hidden="true">*</span></label>
                    <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="f-name-err" />
                    <p class="field__error" id="f-name-err"></p>
                  </div>
                  <div class="field">
                    <label for="f-partner">Your partner’s name <span class="opt">optional</span></label>
                    <input id="f-partner" name="partner" type="text" autocomplete="off" />
                  </div>
                </div>
                <div class="form__row">
                  <div class="field">
                    <label for="f-email">Email <span class="req" aria-hidden="true">*</span></label>
                    <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="f-email-err" />
                    <p class="field__error" id="f-email-err"></p>
                  </div>
                  <div class="field">
                    <label for="f-phone">Phone <span class="opt">optional</span></label>
                    <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" aria-describedby="f-phone-err" />
                    <p class="field__error" id="f-phone-err"></p>
                  </div>
                </div>
              </fieldset>

              <fieldset class="form__group">
                <legend class="form__legend">About the day</legend>
                <div class="form__row">
                  <div class="field">
                    <label for="f-date">When are you thinking?</label>
                    <input id="f-date" name="date" type="text" placeholder="e.g. June 2027, or next spring" aria-describedby="f-date-help" />
                    <label class="check">
                      <input type="checkbox" name="flexible" value="yes" />
                      <span>Our date is flexible</span>
                    </label>
                    <p class="field__help visually-hidden" id="f-date-help">A month, a season or an exact date are all fine.</p>
                  </div>
                  <div class="field">
                    <label for="f-guests">Roughly how many guests? <span class="req" aria-hidden="true">*</span></label>
                    <input
                      id="f-guests"
                      name="guests"
                      type="number"
                      inputmode="numeric"
                      min="1"
                      max="100"
                      step="1"
                      required
                      aria-describedby="f-guests-help f-guests-err"
                    />
                    <p class="field__help" id="f-guests-help">Up to 100 through the day. A guess is fine.</p>
                    <p class="field__error" id="f-guests-err"></p>
                  </div>
                </div>

                <div class="field">
                  <span class="field__label" id="f-visit-label">Would you like to visit?</span>
                  <div class="choices" role="radiogroup" aria-labelledby="f-visit-label">
                    <label class="choice">
                      <input type="radio" name="visit" value="Yes, we'd like to arrange a visit" checked />
                      <span>Yes, let’s arrange one</span>
                    </label>
                    <label class="choice">
                      <input type="radio" name="visit" value="Not yet, please just get in touch" />
                      <span>Not yet, just get in touch</span>
                    </label>
                  </div>
                </div>

                <div class="field">
                  <label for="f-message">Tell us about the day you’re imagining <span class="opt">optional</span></label>
                  <textarea id="f-message" name="message" rows="4" placeholder="The feel you’re after, the food you love, whether the dog is coming…"></textarea>
                </div>

                <div class="field">
                  <label for="f-heard">How did you hear about us? <span class="opt">optional</span></label>
                  <select id="f-heard" name="heard">
                    <option value="">Choose one</option>
                    <option>A friend or family member</option>
                    <option>We came to a wedding here</option>
                    <option>Instagram</option>
                    <option>A wedding directory or magazine</option>
                    <option>Searching online</option>
                    <option>Somewhere else</option>
                  </select>
                </div>
              </fieldset>

              <div class="form__footer">
                <button class="btn btn--dark form__submit magnetic" type="submit">
                  <span class="form__submit-label">Send enquiry</span>
                </button>
                <p class="form__small">We’ll only use your details to reply to you about your wedding.</p>
              </div>
              <p class="form__status" role="alert" aria-live="assertive"></p>
            </form>

            <div class="form-success" tabindex="-1" hidden>
              <img src="/img/logo-crest-ink.webp" alt="" width="160" height="148" />
              <h3>Thank you<span data-success-name></span>.</h3>
              <p>
                Your enquiry is with us. Someone from the Ashden team will be in
                touch personally, usually to suggest a time to come and look round.
              </p>
              <a class="link-arrow link-arrow--dark" href="#top">Back to the top</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <img class="site-footer__logo" src="/img/logo-full-chalk.webp" alt="Ashden Manor, established 2026" width="640" height="624" loading="lazy" />
        <p class="site-footer__tagline">Timeless celebrations in the heart of the English countryside.</p>
        <nav class="site-footer__nav" aria-label="Footer">
          <a href="#exclusive-use">The manor</a>
          <a href="#food">Food</a>
          <a href="#the-day">Your day</a>
          <a href="#enquire">Questions</a>
          <a href="#enquire">Enquire</a>
        </nav>
        <p class="site-footer__legal">© 2026 Ashden Manor</p>
      </div>
    </footer>

    <script>
      import '../scripts/reveal';
      import '../scripts/enquiry';
      import '../scripts/motion';

      const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const siteNav = document.querySelector<HTMLElement>('.site-nav');

      if (navToggle && siteNav) {
        const closeMenu = () => {
          navToggle.setAttribute('aria-expanded', 'false');
          navToggle.setAttribute('aria-label', 'Open navigation');
          siteNav.classList.remove('is-open');
        };

        navToggle.addEventListener('click', () => {
          const isOpen = navToggle.getAttribute('aria-expanded') === 'true';
          navToggle.setAttribute('aria-expanded', String(!isOpen));
          navToggle.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
          siteNav.classList.toggle('is-open', !isOpen);
        });

        siteNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 960) closeMenu();
        });
      }
    </script>
  </body>
</html>